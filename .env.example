# Copy to .env and fill in. Same values as the old site (vavencloud-static-website, as used on vavencloud.com).
# Both are public. In CI, set them as variables of the build job, or the booking form can't send anything.
# Contact form backend: POST {VITE_API_BASE_URL}/api/contact
VITE_API_BASE_URL=https://vavensoft.com
# Google reCAPTCHA v3 site key (public). The landing page's domain must be on this key's domain list
# (Google reCAPTCHA admin console), or every request is rejected.
VITE_RECAPTCHA_SITE_KEY=6Le5jugrAAAAAB8QlnJethbuXnHpTlkkXU8rFTbt
